# این را به `.env` کپی کن؛ docker compose خودش می‌خواندش.
# همه‌ی مقدارها اختیاری‌اند — بدونشان هم بالا می‌آید، فقط لاغرتر.

# پورت رابط کاربری
UNSTREAM_PORT=8080

# --- کوکی یوتیوب ---
# داخل کانتینر کوکی از مرورگر خوانده نمی‌شود. فایل Netscape را از افزونه‌ی
# «Get cookies.txt» بگیر، در `secrets/cookies.txt` بگذار، و این خط را باز کن.
# UNSTREAM_COOKIES_FILE=/secrets/cookies.txt

# --- اسپاتیفای (اختیاری) ---
# بدون این‌ها لینک اسپاتیفای فقط از روی عنوان حدس زده می‌شود و پلی‌لیست کار نمی‌کند.
# https://developer.spotify.com/dashboard
# UNSTREAM_SPOTIFY_CLIENT_ID=
# UNSTREAM_SPOTIFY_CLIENT_SECRET=

# --- Genius (اختیاری) ---
# متن آهنگ وقتی LRCLIB (بی‌کلید، اولویت اول) چیزی پیدا نکند. فقط متن ساده،
# بدون هم‌زمان‌سازی. https://genius.com/api-clients
# UNSTREAM_GENIUS_ACCESS_TOKEN=

# --- AcoustID (اختیاری) ---
# دو کار با یک کلید: فایلِ دانلودشده را با فینگرپرینت صوتی چک می‌کند، و
# شناساییِ *فایلِ کامل* را روشن می‌کند. `fpcalc` داخل ایمیج هست.
# https://acoustid.org/new-application
# UNSTREAM_ACOUSTID_KEY=

# --- AudD (اختیاری) ---
# شناسایی از روی تکه‌ی کوتاه یا ضبطِ میکروفون — حالتِ «شزم»، که AcoustID
# انجامش نمی‌دهد. بدون این توکن هیچ صوتی از سرور بیرون نمی‌رود.
# https://dashboard.audd.io
# UNSTREAM_AUDD_TOKEN=

# --- هم‌ترازی بلندی (اختیاری) ---
# پیش‌فرض روشن است: بلندیِ هر فایل یک بار با ffmpeg اندازه گرفته می‌شود تا
# پخش‌کننده همه را هم‌تراز پخش کند. خودِ فایل دست‌نخورده می‌ماند.
# UNSTREAM_LOUDNESS=0
# UNSTREAM_LOUDNESS_TARGET=-14

# --- پروکسی (اختیاری) ---
# روی همه‌ی ترافیک بیرونی اثر می‌گذارد: yt-dlp، کاتالوگ‌ها، متن آهنگ و کاور.
# داخل کانتینر، `127.0.0.1` خودِ کانتینر است — برای پروکسیِ روی هاست از
# `host.docker.internal` استفاده کن.
# UNSTREAM_PROXY=socks5h://host.docker.internal:1080

# --- چت‌بات وایب (اختیاری) ---
# پیشنهاد پلی‌لیست بر اساس حال‌وهوا: تشخیصِ پیام با Gemini. بدون کلید به
# نگاشتِ کلیدواژه‌ای فارسی برمی‌گردد — چت همچنان کار می‌کند، فقط دقتش کمتر است.
# https://aistudio.google.com/apikey
# UNSTREAM_GEMINI_API_KEY=

# --- بات تلگرام (اختیاری) ---
# اسم آهنگ یا لینک به بات بفرست، فایل برمی‌گردد. توکن رایگان: @BotFather → /newbot.
# با این ست‌شده هم بات بالا نمی‌آید مگر با «docker compose --profile bot up».
# UNSTREAM_TELEGRAM_BOT_TOKEN=

# هر چند وقت یک‌بار /follow چک شود (ثانیه، پیش‌فرض ۱۸۰۰)
# UNSTREAM_FOLLOW_POLL_INTERVAL=1800

# Inline mode (@botname آهنگ): اول @BotFather → /setinline. برای اینکه نتیجه‌ی
# انتخاب‌شده خودِ فایل باشد نه فقط لینک، آیدیِ یک چت/کانالِ خصوصی که بات در آن
# ادمین است بده — فایل یک‌بار همان‌جا برای گرفتنِ file_id فرستاده می‌شود.
# UNSTREAM_TELEGRAM_CACHE_CHAT_ID=

# --- تنظیم ---
# UNSTREAM_CONCURRENCY=3
# فایل‌های دانلودشده بعد از این مدت پاک می‌شوند (ثانیه). صفر = هرگز.
# UNSTREAM_FILE_RETENTION=604800

# --- حالت اینترانت (قطعیِ اینترنتِ بین‌الملل) ---
#
# پیش‌فرض‌ها برای همین سناریو تنظیم شده‌اند و لازم نیست چیزی ست کنی. این‌ها
# برای وقتی است که بخواهی رفتار را عوض کنی — جزئیات در بخشِ «حالت اینترانت»
# در README.
#
# کاور را روی دیسکِ سرور آینه می‌کند تا موقعِ قطعی کتابخانه بی‌کاور نماند.
# خاموش کردنش یعنی برگشت به آدرسِ مستقیمِ CDN.
# UNSTREAM_ART_MIRROR=1
#
# جستجو و صفحه‌ی آلبوم/هنرمند را کش می‌کند تا موقعِ قطعی از همان‌ها جواب بدهد.
# UNSTREAM_CATALOG_CACHE=1
#
# دانلودی که موقعِ قطعی خواسته شود به‌جای شکست در صف می‌ماند و با برگشتنِ
# اینترنت خودکار شروع می‌شود.
# UNSTREAM_DEFER_DOWNLOADS=1
#
# آدرس‌هایی که برای تشخیصِ «بین‌الملل هست یا نه» زده می‌شوند، جدا با کاما.
# هر پاسخِ HTTP یعنی رسیدیم — حتی ۴۰۴. خالی گذاشتنش تشخیص را خاموش می‌کند.
#
# عمداً خودِ کاتالوگ‌ها اینجا نیستند: اپل آی‌پیِ ایران را تحریم کرده و دیزر
# geo-block دارد، پس مرتب قطع‌ووصل می‌شوند در حالی که اینترنت سالم است — و
# برنامه بی‌دلیل به حالتِ اینترانت می‌رفت. این سه تا سیاست جغرافیایی ندارند و
# سومی با آی‌پی صدا می‌شود تا وقتی DNS هم دستکاری شده جواب بدهد.
# UNSTREAM_REACH_PROBES=https://cloudflare.com/cdn-cgi/trace,https://www.gstatic.com/generate_204,https://1.1.1.1/cdn-cgi/trace
# UNSTREAM_REACH_TIMEOUT=6
#
# چند شکستِ پیاپی لازم است تا «قطع» اعلام شود. برگشتن به آنلاین همیشه با یک
# موفقیت است — نامتقارنی عمدی است چون اعلامِ اشتباهِ «قطع» خیلی گران‌تر است.
# UNSTREAM_REACH_STRIKES=2
# UNSTREAM_REACH_INTERVAL=120
# UNSTREAM_REACH_RETRY_INTERVAL=30
#
# کاورهایی که آدرسشان ثبت شده ولی هنوز گرفته نشده‌اند را در پس‌زمینه می‌گیرد.
# UNSTREAM_ART_WARM=1
