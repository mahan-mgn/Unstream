# این را به `.env` کپی کن؛ docker compose خودش می‌خواندش.
# همه‌ی مقدارها اختیاری‌اند — بدونشان هم بالا می‌آید، فقط لاغرتر.

# پورت رابط کاربری
UNSTREAM_PORT=8080

# --- کوکی یوتیوب ---
# داخل کانتینر کوکی از مرورگر خوانده نمی‌شود. فایل Netscape را از افزونه‌ی
# «Get cookies.txt» بگیر، در `secrets/cookies.txt` بگذار، و این خط را باز کن.
# UNSTREAM_COOKIES_FILE=/secrets/cookies.txt

# --- اسپاتیفای (اختیاری) ---
# بدون این‌ها لینک اسپاتیفای فقط از روی عنوان حدس زده می‌شود و پلی‌لیست کار نمی‌کند.
# https://developer.spotify.com/dashboard
# UNSTREAM_SPOTIFY_CLIENT_ID=
# UNSTREAM_SPOTIFY_CLIENT_SECRET=

# --- AcoustID (اختیاری) ---
# فایل دانلودشده را با فینگرپرینت صوتی چک می‌کند. https://acoustid.org/new-application
# UNSTREAM_ACOUSTID_KEY=

# --- تنظیم ---
# UNSTREAM_CONCURRENCY=3
# فایل‌های دانلودشده بعد از این مدت پاک می‌شوند (ثانیه). صفر = هرگز.
# UNSTREAM_FILE_RETENTION=604800
